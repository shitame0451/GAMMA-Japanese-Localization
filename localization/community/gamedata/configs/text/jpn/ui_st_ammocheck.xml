    <string id="rax_ammo_check_display_highlight_ammo_mode_lst_ham_combined">
        <text>複合表示</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_display_msg_duration">
        <text>メッセージの表示時間</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_display_msg_duration_desc">
        <text>残弾ステータスのメッセージを画面上に表示し続ける時間（秒）を設定します。</text>
    </string>

    <!-- HUD Settings -->
    <string id="ui_mcm_rax_ammo_check_hud_behavior_hidecounter">
        <text>弾薬カウンターを非表示</text>
