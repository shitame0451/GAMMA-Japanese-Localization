    <string id="ui_mcm_rax_ammo_check_hud_behavior_hidecounter_desc">
        <text>HUDに表示される弾数カウントを隠し、より没入感のある体験を提供します。</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_hud_behavior_hideicon">
