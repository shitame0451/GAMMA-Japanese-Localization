    <!-- Animation Settings -->
    <string id="ui_mcm_rax_ammo_check_animation_enable_animations">
        <text>アニメーションを有効化</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_animation_enable_animations_desc">
        <text>全アニメーション機能のマスタースイッチです。オフにすると、武器の動作を伴わずメッセージ表示のみが行われます。</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_animation_anim_mode">
        <text>代替マガジン点検アクション</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_animation_anim_mode_desc">
        <text>専用のインスペクトアニメーションを持たない武器において、どのアニメーションを代わりに再生するか設定します。「デフォルト」は武器の出し入れ、「武器を下げる」は一瞬銃口を下げます。「擬似リロード」はマガジン式ならリロード動作を、固定内蔵式なら特殊な動作を流用します。</text>
    </string>
    <!-- Animation Mode List Options -->
    <string id="rax_ammo_check_animation_anim_mode_lst_anim_mode_default">
        <text>デフォルト（武器の出し入れ）</text>
    </string>
    <string id="rax_ammo_check_animation_anim_mode_lst_anim_mode_lower">
