    </string>

    <!-- Behavior Settings -->
    <string id="ui_mcm_rax_ammo_check_hud_behavior_check_grenade_mode">
        <text>グレネードモード中も確認を許可</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_hud_behavior_check_grenade_mode_desc">
        <text>アンダーバレル・グレネードランチャーの使用中も、残弾確認を行えるようにします。</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_hud_behavior_auto_check_reload">
        <text>リロード後に自動で確認する</text>
