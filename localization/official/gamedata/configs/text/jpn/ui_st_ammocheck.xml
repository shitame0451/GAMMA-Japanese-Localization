        <text>表示位置</text>
    </string>
    <string id="ui_mcm_rax_ammo_check_render_position_desc">
        <text>カスタム・テキスト表示を画面のどこに配置するかを選択します。</text>
    </string>
    <string id="rax_ammo_check_render_position_lst_rp_tl">
        <text>左上</text>
