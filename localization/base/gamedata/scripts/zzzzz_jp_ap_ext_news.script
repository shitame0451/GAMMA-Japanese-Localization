-- ap_ext_news.script

if not ap_ext_news then
	return
end

-- ===================================================================
--  xlevel.get_smart_display_name （AlifePlusの#Location#に挿入される地名を短縮）
-- ===================================================================
if xlevel
and xlevel.get_smart_display_name
then
	local original_get_smart_display_name = xlevel.get_smart_display_name
	xlevel.get_smart_display_name = function(smart, ...)
		local name = original_get_smart_display_name(smart, ...)

		if name and smart then
			local info = debug.getinfo(2, "S")
			if info and info.short_src and string.find(info.short_src, "ap_ext_news", 1, true) then
				local smart_level = xlevel.get_level_id(smart)
				local actor_level = xlevel.get_actor_level_id()
				if smart_level and actor_level and smart_level ~= actor_level then
					-- エリア外: 「ザトンの[スカドフスク]」と表示
					local match = string.gsub(name, "%s+(%[)", "の%1")
					return match
				else
					-- エリア内: 「[スカドフスク]」と表示
					local match = string.match(name, "(%[.+%])")
					if match then return match end
				end
			end
		end

		return name
	end
end

-- ===================================================================
--  _substitute （タグに何も挿入されなかった場合、後ろの1文字を削除 & ミリタリー置換）
-- ===================================================================
local function patch_news_internals()
	local compose_tick = ap_ext_news.compose_tick
	local compose_impl

	local i = 1
	while true do
		local name, value = debug.getupvalue(compose_tick, i)
		if not name then break end
		if name == "_compose_tick_impl" then
			compose_impl = value
			break
		end
		i = i + 1
	end

	if type(compose_impl) ~= "function" then return end

	local substitute_index
	local original_substitute
	local j = 1
	while true do
		local name, value = debug.getupvalue(compose_impl, j)
		if not name then break end
		if name == "_substitute" then
			substitute_index = j
			original_substitute = value
			break
		end
		j = j + 1
	end

	if not substitute_index or type(original_substitute) ~= "function" then return end

	local removable_tags = {
		subject_faction = true,
		subject_species = true,
		subject_name = true,
		other_faction = true,
	}
	local utf8_pattern = "[\1-\127\192-\255][\128-\191]*"
	local tagged_character_pattern = "#([%w_]+)#(" .. utf8_pattern .. ")"

	debug.setupvalue(compose_impl, substitute_index, function(template, slots, ...)
		local result = string.gsub(template, tagged_character_pattern, function(tag, following_character)
			if removable_tags[tag] and slots[tag] == "" then return "" end
			return "#" .. tag .. "#" .. following_character
		end)

		local final_msg = original_substitute(result, slots, ...)
		local translated_msg = string.gsub(final_msg, "ミリタリー", "軍")
		return translated_msg
	end)
end

if ap_ext_news.compose_tick then
	patch_news_internals()
end
