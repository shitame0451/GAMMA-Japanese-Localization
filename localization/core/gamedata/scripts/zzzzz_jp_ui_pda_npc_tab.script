-- ui_pda_npc_tab.script

if not ui_pda_npc_tab then
	return
end

-- ===================================================================
--  generate_msg （日本語環境で $fname と $lname を表示できるようにする）
-- ===================================================================
if ui_pda_npc_tab.generate_msg then
	local original_generate_msg = ui_pda_npc_tab.generate_msg

	ui_pda_npc_tab.generate_msg = function(contact, older_date, special, special_functor, ...)
		local info = original_generate_msg(contact, older_date, special, special_functor, ...)
		if not info then return nil end

		-- contact.name から fname と lname を抽出
		if contact and type(contact.name) == "string" then
			-- 中黒で区切る
			local first, last = string.match(contact.name, "^(.-)・(.-)$")
			if first and last then
				info.fname = first
				info.lname = last
			else
				-- 中黒がない場合（◯◯中尉など）は全部 fname に入れる
				info.fname = contact.name
				info.lname = ""
			end
		end

		return info
	end
end

if not ui_pda_npc_tab.pda_npc_tab then
	return
end

-- ===================================================================
--  pda_npc_tab:Reset （PDA の NPC タブに日本語名変換を適用）
-- ===================================================================
if ui_pda_npc_tab.pda_npc_tab.Reset then
	local original_Reset = ui_pda_npc_tab.pda_npc_tab.Reset

	ui_pda_npc_tab.pda_npc_tab.Reset = function(self, info, ...)
		local result = original_Reset(self, info, ...)

		-- 暗号化・特殊状態では表示を変更しない
		if not info or self.state ~= "default" then
			return result
		end

		-- contact.name の切り捨て（文字数が多いと"..."で省略される処理）無効化
		if self.contact and self.contact_info and self.contact_info.name then
			local name = self.contact.name
			if type(name) == "string" then
				self.contact_info.name:SetText(name)
			end
		end

		-- sender の名前変換
		local message_entry = ui_pda_npc_tab.pda_message_entry or pda_message_entry
		if type(self.msg) == "table"
		and self.message_list
		and message_entry
		then
			self.message_list:RemoveAll()

			local st_date = game.translate_string("date")
			local name = self.contact and self.contact.name or ""

			for i=1,#self.msg do
				local msg = self.msg[i]
				local title = msg.topic_title
				local msg_date = strformat(st_date .. ": %s", msg.msg_date)

				local sender = (not msg.stash)
					and strformat("%s %s", msg.c1_fname, msg.c1_lname)
					or name

					sender = japanese_patch.character_name_jp(sender)

				local item = message_entry(game.translate_string(title), sender, msg_date, i)
				self.message_list:AddExistingItem(item)
			end
		end

		return result
	end
end

-- ===================================================================
--  pda_npc_tab:OnSelectMessage （fname + lname と c2_fname + c2_lname を変換して表示するキーを追加）
--  オリジナルを実行し、文字列キー処理の直前だけ日本語用キーを追加
-- ===================================================================
if ui_pda_npc_tab.pda_npc_tab.OnSelectMessage then
	local original_OnSelectMessage = ui_pda_npc_tab.pda_npc_tab.OnSelectMessage

	ui_pda_npc_tab.pda_npc_tab.OnSelectMessage = function(self, ...)
		if not utils_data
		or not utils_data.parse_string_keys
		then
			return original_OnSelectMessage(self, ...)
		end

		local original_parse_string_keys = utils_data.parse_string_keys
		utils_data.parse_string_keys = function(content, keys, ...)
			if type(keys) == "table" then
				local fname = keys.fname
				local lname = keys.lname
				if type(fname) == "string" then
					if type(lname) == "string" and #lname > 0 then
						keys.fullname = japanese_patch.character_name_jp(fname .. " " .. lname)
					else
						keys.fullname = fname
					end
				end

				local c2_fname = keys.c2_fname
				local c2_lname = keys.c2_lname or ""
				if type(c2_fname) == "string" then
					local c2_name = c2_fname .. " " .. c2_lname
						keys.c2_fullname = japanese_patch.character_name_jp(c2_name)
				end
			end

			return original_parse_string_keys(content, keys, ...)
		end

		local ok, result = pcall(original_OnSelectMessage, self, ...)
		utils_data.parse_string_keys = original_parse_string_keys
		if not ok then error(result, 0) end
		return result
	end
end
