-- ===================================================================
--  isg_emergency_stash_timer （名前の変換）
--  定期的に送られるUNISGのスタッシュ配置メッセージ
-- ===================================================================
local original_isg_emergency_stash_timer = dialogs_lostzone.isg_emergency_stash_timer

if original_isg_emergency_stash_timer then
	dialogs_lostzone.isg_emergency_stash_timer = function(...)
		local backup_collect_translations = utils_data.collect_translations
		local backup_parse_string_keys = utils_data.parse_string_keys
		local backup_send_tip = dynamic_news_helper.send_tip

		utils_data.collect_translations = function(prefix, translated, ...)
			local result = backup_collect_translations(prefix, translated, ...)
			if type(prefix) == "string"
			and prefix:match("^lname_")
			and type(result) == "table"
			then
				local spaced_names = {}
				for i, name in ipairs(result) do
					spaced_names[i] = " " .. name
				end
				return spaced_names
			end
			return result
		end

		utils_data.parse_string_keys = function(text, keys, key, ...)
			if type(keys) == "table" and type(keys.name) == "string" then
				local replacement_keys = {}
				for name, value in pairs(keys) do
					replacement_keys[name] = value
				end
				replacement_keys.name = japanese_patch.character_name_jp(keys.name)
				keys = replacement_keys
			end
			return backup_parse_string_keys(text, keys, key, ...)
		end

		dynamic_news_helper.send_tip = function(msg, header, timeout, showtime, sender, sound, icon_by, ...)
			if type(header) == "string" then
				local faction = game.translate_string("isg")
				if type(faction) ~= "string" or faction == "" then
					faction = "isg"
				end
				local prefix = faction .. ","
				local name
				if header:sub(1, #prefix) == prefix then
					name = header:sub(#prefix + 1):gsub("^%s+", "")
				end
				if name then
					local jp_name = japanese_patch.character_name_jp(name)
					header = jp_name .. "（" .. faction .. "）"
				end
			end
			return backup_send_tip(msg, header, timeout, showtime, sender, sound, icon_by, ...)
		end

		local ok, result = pcall(original_isg_emergency_stash_timer, ...)
		utils_data.collect_translations = backup_collect_translations
		utils_data.parse_string_keys = backup_parse_string_keys
		dynamic_news_helper.send_tip = backup_send_tip
		if not ok then error(result, 0) end
		return result
	end
end
