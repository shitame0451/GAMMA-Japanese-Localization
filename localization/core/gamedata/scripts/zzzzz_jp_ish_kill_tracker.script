-- ish_kill_tracker.script

if not ish_kill_tracker
or not ish_kill_tracker.add_body_dot
then
	return
end

-- ===================================================================
--  殺害者名の前のカンマを改行にする （キルマーカーのマウスオーバー表示のみ）
-- ===================================================================
local function format_tooltip_text(text)
	if type(text) ~= "string" then
		return text
	end

	local killed_by = game.translate_string("st_kiltrak_killedby")
	if type(killed_by) ~= "string" or killed_by == "" then
		return text
	end

	local separator = ", " .. killed_by
	local start = string.find(text, separator, 1, true)
	if not start then
		return text
	end

	return text:sub(1, start - 1) .. "\\n" .. text:sub(start + 2)
end

local original_add_body_dot = ish_kill_tracker.add_body_dot

ish_kill_tracker.add_body_dot = function(id, text, ...)
	return original_add_body_dot(id, format_tooltip_text(text), ...)
end
