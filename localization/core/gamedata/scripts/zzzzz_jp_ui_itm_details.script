-- ui_itm_details.script

if not ui_itm_details
or not ui_itm_details.UIItemSheet
then
	return
end

-- ===================================================================
--  UIItemSheet:AddText （アイテムの詳細ウィンドウ）
--  「弾薬:」(ui_ammo_types)と「交換部品:」(st_ui_awr_parts_list)の色指定
--  ui_st_inventory.xmlで色指定できるが、テキストを共有しているアイテムチップ側で文字列として表示されてしまうため、ここで指定
-- ===================================================================
if ui_itm_details.UIItemSheet.AddText then
	local original_AddText = ui_itm_details.UIItemSheet.AddText

	ui_itm_details.UIItemSheet.AddText = function(self, xml, path, offset, txt, ...)
		if txt == game.translate_string("ui_ammo_types") then
			txt = utils_xml.get_color("pda_white") .. txt
		end
		if txt == game.translate_string("st_ui_awr_parts_list") then
			txt = utils_xml.get_color("pda_white") .. txt
		end
		-- 説明文と直後のステータス欄の間に余白を設ける
		if path == "text_s_l" then
			-- 詳細画面の「説明文 → ステータス欄」の余白。広げる場合は15を増やす
			offset = (offset or 0) + 15
		end
		return original_AddText(self, xml, path, offset, txt, ...)
	end
end

-- ===================================================================
--  utils_ui.get_stats_xml （詳細ウィンドウのステータス表示）
--  アイテムチップと同じように、項目名と数値をアイコンに揃える
-- ===================================================================
if utils_ui.get_stats_xml then
	local stats_xml = CScriptXmlInit()
	stats_xml:ParseFile("utils.xml")

	utils_ui.get_stats_xml = function(handler, obj, sec, gr, stat)
		if type(gr) == "string" then
			gr = utils_ui.stats_table[gr]
		end
		if not gr then
			return
		end

		local value, nclr = utils_ui.get_stats_string_value(obj, sec, gr, stat)
		if not value then
			return
		end

		local st = stats_xml:InitStatic("item_info:stats_box", handler)

		local st_icon = stats_xml:InitStatic("item_info:stats_box:icon", st)
		local icon_p = gr.icon_p
		local icon_n = gr.icon_n ~= "" and gr.icon_n or icon_p
		local icon = icon_p
		if type(value) == "number" then
			icon = value < 0 and icon_n or icon_p
			if gr.sign_inverse then
				icon = value < 0 and icon_p or icon_n
			end
		end
		st_icon:InitTexture(icon)

		local st_cap = stats_xml:InitTextWnd("item_info:stats_box:cap", st)
		st_cap:SetText(game.translate_string(gr.name))
		local cap_pos = st_cap:GetWndPos()
		-- 詳細画面のステータス項目名の上下位置。下の2を増やすと上へ移動する
		st_cap:SetWndPos(vector2():set(cap_pos.x, cap_pos.y - 2))

		if gr.track then
			local st_bar = stats_xml:InitProgressBar("item_info:stats_box:prog_bar", st)
			st_bar:SetProgressPos(clamp(value, 0, 1))
			st_bar:SetColor(GetARGB(200, 255, 255, 255))
		else
			local st_txt = stats_xml:InitTextWnd("item_info:stats_box:prog_txt", st)
			st_txt:SetText(value)
			st_txt:SetTextColor(nclr and GetARGB(255, 200, 50, 50) or GetARGB(255, 170, 170, 170))
			local txt_pos = st_txt:GetWndPos()
			-- 詳細画面のステータス数値位置。15は左方向、2は上方向の移動量
			st_txt:SetWndPos(vector2():set(txt_pos.x - 15, txt_pos.y - 2))
		end

		st:SetAutoDelete(true)
		return st
	end
end

-- ===================================================================
--  UIItemSheet:AddStat / AddSpace （詳細ウィンドウのステータス後の余白）
-- ===================================================================
if ui_itm_details.UIItemSheet.AddStat
and ui_itm_details.UIItemSheet.AddSpace
then
	local original_AddStat = ui_itm_details.UIItemSheet.AddStat
	local original_AddSpace = ui_itm_details.UIItemSheet.AddSpace

	ui_itm_details.UIItemSheet.AddStat = function(self, xml, path, offset, obj, stat, gr, ...)
		local result = original_AddStat(self, xml, path, offset, obj, stat, gr, ...)
		if result then
			self._jp_detail_stats_added = true
		end
		return result
	end

	ui_itm_details.UIItemSheet.AddSpace = function(self, xml, offset, ...)
		if self._jp_detail_stats_added then
			self._jp_detail_stats_added = nil
			-- 詳細画面の「ステータス欄 → 弾薬などの後続欄」の余白。広げる場合は0を増やす
			offset = 0
		end
		return original_AddSpace(self, xml, offset, ...)
	end
end

-- ===================================================================
--  UIItemSheet:AddSpec （詳細ウィンドウの重量表示）
-- ===================================================================
if ui_itm_details.UIItemSheet.AddSpec then
	local original_AddSpec = ui_itm_details.UIItemSheet.AddSpec

	ui_itm_details.UIItemSheet.AddSpec = function(self, xml, path, offset, name, value, clr_1, clr_2, sign, unit, ...)
		-- オリジナルはvalueがない場合に何も追加しない
		if not value then
			return original_AddSpec(self, xml, path, offset, name, value, clr_1, clr_2, sign, unit, ...)
		end

		if name == "ui_total_weight" then
			local translated = game.translate_string(name)

			-- ラベル部分: オレンジのドット + 白文字の「重量:」
			local label = utils_xml.get_color("d_orange") .. " • " .. utils_xml.get_color("pda_white") .. translated

			-- 値部分: グレーで表示
			local val = utils_xml.get_color("ui_gray_1") .. (sign or "") .. tostring(value)
			if unit then
				val = val .. " " .. game.translate_string(unit)
			end

			-- 改行を追加
			local str = label .. " " .. val .. "\\n"

			local _st = xml:InitStatic("itm_details:form", nil)
			local _ele = xml:InitTextWnd("itm_details:form:" .. path, _st)
			_ele:SetText(str)
			_ele:AdjustHeightToText()

			utils_xml.sync_size(_ele, _st, 0, offset)
			self.scroll:AddWindow(_st, true)
			_st:SetAutoDelete(true)
			return _ele
		end

		return original_AddSpec(self, xml, path, offset, name, value, clr_1, clr_2, sign, unit, ...)
	end
end
