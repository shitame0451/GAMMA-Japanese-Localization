-- xr_effects.script

-- ===================================================================
--  名前, 派閥名 → 名前（派閥名）の変換
--  オリジナルのニュース処理を呼び出し、送信者名だけを一時的に整形する
-- ===================================================================
local function format_news_caption(caption)
	if type(caption) ~= "string" then
		return caption
	end

	local name, comm = caption:match("^(.-),%s*(.+)$")
	if name and comm then
		return name .. "（" .. comm .. "）"
	end

	return caption
end

-- yanov_invitation
if xr_effects and xr_effects.yanov_invitation then
	local original_yanov_invitation = xr_effects.yanov_invitation

	xr_effects.yanov_invitation = function(...)
		if not db or not db.actor or not db.actor.give_game_news then
			return original_yanov_invitation(...)
		end

		local backup_game_news = db.actor.give_game_news
		db.actor.give_game_news = function(self, caption, text, icon, delay, showtime, ...)
			return backup_game_news(self, format_news_caption(caption), text, icon, delay, showtime, ...)
		end

		local results = { pcall(original_yanov_invitation, ...) }
		db.actor.give_game_news = backup_game_news
		if not results[1] then error(results[2], 0) end
		return unpack(results, 2)
	end
end

