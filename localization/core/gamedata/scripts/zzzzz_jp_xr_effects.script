-- ===================================================================
--  drx_sl_change_factions （派閥加入時のメッセージ）
-- ===================================================================
if xr_effects and xr_effects.drx_sl_change_factions then
	local original_drx_sl_change_factions = xr_effects.drx_sl_change_factions

	xr_effects.drx_sl_change_factions = function(actor, npc, p, ...)
		if not db or not db.actor or not news_manager or not news_manager.send_tip then
			return original_drx_sl_change_factions(actor, npc, p, ...)
		end
		if not (p and p[1] ~= nil and p[1] ~= ("actor_" .. character_community(db.actor))) then
			return original_drx_sl_change_factions(actor, npc, p, ...)
		end

		local original_msg = game.translate_string("st_drx_questlines_joined") .. " " .. game.translate_string(p[1]) .. " " .. game.translate_string("st_drx_questlines_faction")
		local backup_send_tip = news_manager.send_tip
		news_manager.send_tip = function(send_actor, news_id, ...)
			if send_actor == db.actor and news_id == original_msg then
				return false
			end
			return backup_send_tip(send_actor, news_id, ...)
		end

		local results = { pcall(original_drx_sl_change_factions, actor, npc, p, ...) }
		news_manager.send_tip = backup_send_tip
		if not results[1] then error(results[2], 0) end

		local msg = "派閥「" .. game.translate_string(p[1]) .. "」に加入した"
		news_manager.send_tip(db.actor, msg, nil, "completionist", nil, nil)
		return unpack(results, 2)
	end
end
